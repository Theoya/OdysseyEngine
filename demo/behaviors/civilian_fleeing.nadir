// civilian_fleeing.nadir — Civilian panic behavior: flee from danger, seek safety
#include "scoring.glsl"
#include "steering.glsl"
#include "state_machine.glsl"
#include "debug.glsl"

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= total_entities) return;

    vec3 pos = positions[idx].xyz;
    float spd = stats[idx].speed;
    vec3 player_pos = player_position.xyz;
    float dt = delta_time;

    float dist = length(pos - player_pos);
    float danger = score_proximity(dist, 25.0);

    // State: IDLE or FLEE
    uint state = persist[idx].current_state;
    float timer = persist[idx].state_timer + dt;

    uint new_state = (danger > 0.3) ? STATE_FLEE : STATE_IDLE;
    if (new_state != state) timer = 0.0;

    vec3 move = vec3(0.0);
    float weight = 0.0;

    if (new_state == STATE_FLEE) {
        // Flee from player with some scatter
        float scatter = sin(float(idx) * 7.13 + world_time) * 0.3;
        vec3 flee_dir = steer_flee(pos, player_pos, spd);
        vec3 scatter_dir = cross(normalize(flee_dir), vec3(0,1,0)) * scatter * spd;
        move = flee_dir + scatter_dir;
        weight = danger;
    } else {
        // Idle: slow wander
        move = steer_wander(vec3(0,0,1), 2.0, 3.0, 0.5, float(idx) + world_time * 0.1) * spd * 0.2;
        weight = 0.2;
    }

    float mlen = length(move);
    if (mlen > spd) move = (move / mlen) * spd;

    outputs[idx].move_vector = vec4(move, weight);
    outputs[idx].attack_target = vec4(0.0);
    outputs[idx].animation_id = (new_state == STATE_FLEE) ? 2u : 0u;
    outputs[idx].animation_blend = clamp(mlen / spd, 0.0, 1.0);
    outputs[idx].sound_event = (new_state == STATE_FLEE && timer < 0.5) ? 6u : 0u; // scream
    outputs[idx].sound_priority = danger * 0.5;
    outputs[idx].comms_signal = 0.0;
    outputs[idx].comms_urgency = 0.0;
    outputs[idx].action_request = 0u;
    outputs[idx].action_priority = 0.0;

    persist[idx].current_state = new_state;
    persist[idx].state_timer = timer;

    debug_state_color(idx, new_state);
}
