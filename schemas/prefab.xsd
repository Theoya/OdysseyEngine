<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="https://odysseyengine.dev/prefab"
           xmlns:od="https://odysseyengine.dev/prefab"
           elementFormDefault="qualified">

  <!-- Root element -->
  <xs:element name="prefab" type="od:PrefabType"/>

  <xs:complexType name="PrefabType">
    <xs:sequence>
      <xs:element name="components" type="od:ComponentsType" minOccurs="1" maxOccurs="1"/>
    </xs:sequence>
    <xs:attribute name="name"    type="xs:string"          use="required"/>
    <xs:attribute name="version" type="xs:positiveInteger" use="required"/>
  </xs:complexType>

  <!-- Components container -->
  <xs:complexType name="ComponentsType">
    <xs:all>
      <xs:element name="transform" type="od:TransformType" minOccurs="0"/>
      <xs:element name="stats"     type="od:StatsType"     minOccurs="0"/>
      <xs:element name="behavior"  type="od:BehaviorType"  minOccurs="0"/>
      <xs:element name="render"    type="od:RenderType"    minOccurs="0"/>
      <xs:element name="collider"  type="od:ColliderType"  minOccurs="0"/>
      <xs:element name="ai_state"  type="od:AIStateType"   minOccurs="0"/>
      <xs:element name="script"    type="od:ScriptType"    minOccurs="0"/>
    </xs:all>
  </xs:complexType>

  <!-- Transform -->
  <xs:complexType name="TransformType">
    <xs:attribute name="position" type="xs:string" default="0 0 0"/>
    <xs:attribute name="rotation" type="xs:string" default="0 0 0"/>
    <xs:attribute name="scale"    type="xs:string" default="1 1 1"/>
  </xs:complexType>

  <!-- Stats -->
  <xs:complexType name="StatsType">
    <xs:attribute name="health"     type="xs:float" default="100.0"/>
    <xs:attribute name="max_health" type="xs:float" default="100.0"/>
    <xs:attribute name="speed"      type="xs:float" default="5.0"/>
    <xs:attribute name="ammo"       type="xs:float" default="0.0"/>
    <xs:attribute name="stamina"    type="xs:float" default="100.0"/>
  </xs:complexType>

  <!-- Behavior (Nadir compute shader) -->
  <xs:complexType name="BehaviorType">
    <xs:attribute name="shader" type="xs:string" use="required"/>
  </xs:complexType>

  <!-- Render -->
  <xs:complexType name="RenderType">
    <xs:attribute name="mesh"     type="xs:string" use="required"/>
    <xs:attribute name="material" type="xs:string" use="required"/>
  </xs:complexType>

  <!-- Collider -->
  <xs:complexType name="ColliderType">
    <xs:attribute name="type"   type="od:ColliderShapeType" use="required"/>
    <xs:attribute name="radius" type="xs:float"/>
    <xs:attribute name="height" type="xs:float"/>
  </xs:complexType>

  <xs:simpleType name="ColliderShapeType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="sphere"/>
      <xs:enumeration value="capsule"/>
      <xs:enumeration value="box"/>
      <xs:enumeration value="mesh"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- AI State -->
  <xs:complexType name="AIStateType">
    <xs:attribute name="initial" type="xs:string" use="required"/>
  </xs:complexType>

  <!-- Script -->
  <xs:complexType name="ScriptType">
    <xs:attribute name="class"  type="xs:string" use="required"/>
    <xs:attribute name="config" type="xs:string"/>
  </xs:complexType>

</xs:schema>
