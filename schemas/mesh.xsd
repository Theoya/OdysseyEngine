<?xml version="1.0" encoding="UTF-8"?>
<!--
  mesh.xsd — mesh descriptor schema.

  Authored form matches odyssey::assets::MeshData (src/assets/mesh_loader.h) and the
  parser in mesh_loader.cpp.  Historical mesh files in demo/materials/*.mesh.xml
  use <lod_levels><lod distance= triangles=/></lod_levels>; the current loader emits
  <lod><level distance= triangles=/></lod>.  This schema accepts BOTH to keep existing
  assets valid while new assets use the canonical form.

  Canonical form (loader-preferred):
    <mesh name="crate" version="1">
      <source format="primitive" path="box"/>  <!-- OR format="obj" path="..." -->
      <dimensions width="1.5" height="1.5" depth="1.5"/>
      <lod>
        <level distance="0"  triangles="12"/>
        <level distance="30" triangles="4"/>
      </lod>
      <collider type="box" auto_fit="true"/>
    </mesh>

  Legacy short form (still valid):
    <source format="primitive">box</source>   <!-- text = path -->
    <lod_levels>
      <lod distance="0" triangles="12"/>
    </lod_levels>
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="https://odysseyengine.dev/mesh"
           xmlns:od="https://odysseyengine.dev/mesh"
           elementFormDefault="qualified">

  <xs:element name="mesh" type="od:MeshType"/>

  <xs:complexType name="MeshType">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="source"     type="od:SourceType"/>
      <xs:element name="dimensions" type="od:DimensionsType"/>
      <xs:element name="lod"        type="od:LodType"/>
      <xs:element name="lod_levels" type="od:LodLevelsLegacyType"/>
      <xs:element name="collider"   type="od:ColliderType"/>
    </xs:choice>
    <xs:attribute name="name"    type="xs:string"          use="required"/>
    <xs:attribute name="version" type="xs:positiveInteger" use="required"/>
  </xs:complexType>

  <!-- <source format="primitive|obj|gltf" path="..."> ; legacy: text() carries path -->
  <xs:complexType name="SourceType">
    <xs:simpleContent>
      <xs:extension base="xs:string">
        <xs:attribute name="format" type="od:SourceFormat" use="required"/>
        <xs:attribute name="path"   type="xs:string"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <xs:simpleType name="SourceFormat">
    <xs:restriction base="xs:string">
      <xs:enumeration value="primitive"/>
      <xs:enumeration value="obj"/>
      <xs:enumeration value="gltf"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="DimensionsType">
    <xs:attribute name="width"  type="xs:float"/>
    <xs:attribute name="height" type="xs:float"/>
    <xs:attribute name="depth"  type="xs:float"/>
    <xs:attribute name="radius" type="xs:float"/>
  </xs:complexType>

  <!-- Canonical <lod><level/></lod> -->
  <xs:complexType name="LodType">
    <xs:sequence>
      <xs:element name="level" type="od:LodLevelType" minOccurs="1" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="LodLevelType">
    <xs:attribute name="distance"  type="xs:float"            default="0.0"/>
    <xs:attribute name="triangles" type="xs:nonNegativeInteger" default="0"/>
  </xs:complexType>

  <!-- Legacy <lod_levels><lod/></lod_levels> -->
  <xs:complexType name="LodLevelsLegacyType">
    <xs:sequence>
      <xs:element name="lod" type="od:LodLevelType" minOccurs="1" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="ColliderType">
    <xs:attribute name="type"     type="od:ColliderShape" use="required"/>
    <xs:attribute name="auto_fit" type="xs:boolean"       default="false"/>
    <xs:attribute name="radius"   type="xs:float"/>
    <xs:attribute name="height"   type="xs:float"/>
    <xs:attribute name="width"    type="xs:float"/>
    <xs:attribute name="depth"    type="xs:float"/>
    <xs:attribute name="src"      type="xs:string"/>   <!-- for type="mesh" -->
  </xs:complexType>

  <xs:simpleType name="ColliderShape">
    <xs:restriction base="xs:string">
      <xs:enumeration value="sphere"/>
      <xs:enumeration value="capsule"/>
      <xs:enumeration value="box"/>
      <xs:enumeration value="plane"/>
      <xs:enumeration value="mesh"/>
    </xs:restriction>
  </xs:simpleType>

</xs:schema>
