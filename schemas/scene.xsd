<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="https://odysseyengine.dev/scene"
           xmlns:od="https://odysseyengine.dev/scene"
           elementFormDefault="qualified">

  <!-- Root element -->
  <xs:element name="scene" type="od:SceneType"/>

  <xs:complexType name="SceneType">
    <xs:sequence>
      <xs:element name="world"  type="od:WorldType"  minOccurs="0" maxOccurs="1"/>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element name="entity"       type="od:EntityType"      />
        <xs:element name="spawn_region" type="od:SpawnRegionType" />
      </xs:choice>
    </xs:sequence>
    <xs:attribute name="name"    type="xs:string"          use="required"/>
    <xs:attribute name="version" type="xs:positiveInteger" use="required"/>
    <!-- Unknown scene-root attrs (e.g. lighting_profile, audio_bank) captured
         by the loader's preserve-unknowns path. -->
    <xs:anyAttribute processContents="skip"/>
  </xs:complexType>

  <!-- World settings: attributes or child elements both permitted. Demo
       showcase uses <time_scale>…</time_scale> child-text form; other scenes
       may use attributes. The loader accepts either. -->
  <xs:complexType name="WorldType">
    <xs:sequence>
      <xs:element name="time_scale" type="xs:float" minOccurs="0"/>
      <xs:element name="gravity"    type="xs:string" minOccurs="0"/>
    </xs:sequence>
    <xs:attribute name="time_scale" type="xs:float" default="1.0"/>
    <xs:attribute name="gravity"    type="xs:float" default="-9.81"/>
  </xs:complexType>

  <!-- Entity -->
  <xs:complexType name="EntityType">
    <xs:sequence>
      <xs:element name="transform"       type="od:TransformType"       minOccurs="0" maxOccurs="1"/>
      <xs:element name="stats"           type="od:StatsType"           minOccurs="0" maxOccurs="1"/>
      <xs:element name="behavior"        type="od:BehaviorType"        minOccurs="0" maxOccurs="1"/>
      <xs:element name="mesh"            type="od:MeshType"            minOccurs="0" maxOccurs="1"/>
      <xs:element name="material"        type="od:MaterialType"        minOccurs="0" maxOccurs="1"/>
      <xs:element name="script"          type="od:ScriptType"          minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="pack"            type="od:PackType"            minOccurs="0" maxOccurs="1"/>
      <!-- Phase 9: Physics + camera components (optional, per-entity basis) -->
      <xs:element name="rigidbody"       type="od:RigidBodyType"       minOccurs="0" maxOccurs="1"/>
      <xs:element name="box_collider"    type="od:BoxColliderType"     minOccurs="0" maxOccurs="1"/>
      <xs:element name="sphere_collider" type="od:SphereColliderType"  minOccurs="0" maxOccurs="1"/>
      <xs:element name="capsule_collider" type="od:CapsuleColliderType" minOccurs="0" maxOccurs="1"/>
      <xs:element name="camera"          type="od:CameraType"          minOccurs="0" maxOccurs="1"/>
      <!-- Free-text gameplay tags. Added in editor Phase 4 as the canonical
           demonstration of the four-step schema-add ritual: EntityComponents
           was extended, this XSD entry, the Inspector's "Tags" sub-editor,
           and the scene_serializer's emit path. Order-preserving; unbounded
           so entities can carry multiple orthogonal tags (e.g. "interactive",
           "flammable", "quest_item"). -->
      <xs:element name="tag"          type="od:TagType"          minOccurs="0" maxOccurs="unbounded"/>
      <!-- spawn_region is also allowed as a CHILD of entity in shooter_arena
           shape (batch-spawn metadata scoped to one entity descriptor). -->
      <xs:element name="spawn_region" type="od:SpawnRegionType"  minOccurs="0" maxOccurs="1"/>
    </xs:sequence>
    <!-- anyAttribute: the loader's "preserve unknowns" path captures attributes
         that are not in the known set (e.g. light_type, kelvin, material_override
         on <entity>) so authoring tooling can add them without a schema bump. -->
    <xs:attribute name="id"        type="xs:string"             use="required"/>
    <xs:attribute name="archetype" type="xs:string"             use="required"/>
    <xs:attribute name="count"     type="xs:positiveInteger"    default="1"/>
    <!-- Phase 9: Optional parent reference (entity id string). When absent, entity
         is top-level. When present, references another entity's id attribute.
         Cycles and missing parents are rejected at load time. -->
    <xs:attribute name="parent"    type="xs:string"             use="optional"/>
    <xs:anyAttribute processContents="skip"/>
  </xs:complexType>

  <!-- Transform -->
  <xs:complexType name="TransformType">
    <xs:attribute name="position" type="xs:string" default="0 0 0"/>
    <xs:attribute name="rotation" type="xs:string" default="0 0 0"/>
    <xs:attribute name="scale"    type="xs:string" default="1 1 1"/>
  </xs:complexType>

  <!-- Stats -->
  <xs:complexType name="StatsType">
    <xs:attribute name="health"     type="xs:float" default="100.0"/>
    <xs:attribute name="max_health" type="xs:float" default="100.0"/>
    <xs:attribute name="speed"      type="xs:float" default="5.0"/>
    <xs:attribute name="ammo"       type="xs:float" default="0.0"/>
    <xs:attribute name="stamina"    type="xs:float" default="100.0"/>
    <xs:attribute name="voice_range" type="od:VoiceRangeType" default="25.0">
      <xs:annotation>
        <xs:documentation xml:lang="en">
          Proximity-voice audibility radius in meters. Default 25.0m = d_max
          from the inverse-amplitude attenuation curve authored in
          docs/design/proximity_chat_audio.md. Authored-time bound is [0, 50];
          the server additionally hard-clamps ingress to 50m at runtime (see
          docs/decisions/2026-04-20-proximity-voice-chat.md, netcode condition
          "anti-cheat hard-clamp"). Loaders reject negative, NaN, and
          &gt; 50 values at authored time; serializer omits this attribute
          when it equals the default so unmutated scenes round-trip bytewise.
        </xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <!-- Voice range: [0, 50] meters. Ratified in
       docs/decisions/2026-04-20-proximity-voice-chat.md. -->
  <xs:simpleType name="VoiceRangeType">
    <xs:restriction base="xs:float">
      <xs:minInclusive value="0.0"/>
      <xs:maxInclusive value="50.0"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Material reference (used by demo showcase meshes). -->
  <xs:complexType name="MaterialType">
    <xs:attribute name="src" type="xs:string" use="required"/>
  </xs:complexType>

  <!-- Behavior (Nadir compute shader) -->
  <xs:complexType name="BehaviorType">
    <xs:attribute name="shader" type="xs:string" use="required"/>
  </xs:complexType>

  <!-- Mesh reference -->
  <xs:complexType name="MeshType">
    <xs:attribute name="src" type="xs:string" use="required"/>
  </xs:complexType>

  <!-- Script -->
  <xs:complexType name="ScriptType">
    <xs:attribute name="class"  type="xs:string" use="required"/>
    <xs:attribute name="config" type="xs:string"/>
  </xs:complexType>

  <!-- Pack (flocking / squad) -->
  <xs:complexType name="PackType">
    <xs:attribute name="leader" type="xs:string" use="required"/>
  </xs:complexType>

  <!-- Tag (Phase 4 free-text gameplay label). Required `name`, no children. -->
  <xs:complexType name="TagType">
    <xs:attribute name="name" type="xs:string" use="required"/>
  </xs:complexType>

  <!-- Phase 9: Physics + Camera Components -->

  <!-- Rigidbody: dynamics enabled. -->
  <xs:complexType name="RigidBodyType">
    <xs:attribute name="mass"         type="xs:float" default="1.0"/>
    <xs:attribute name="drag"         type="xs:float" default="0.01"/>
    <xs:attribute name="angular_drag" type="xs:float" default="0.05"/>
    <xs:attribute name="use_gravity"  type="xs:boolean" default="true"/>
    <xs:attribute name="is_kinematic" type="xs:boolean" default="false"/>
    <xs:attribute name="position"     type="xs:string" default="0 0 0"/>
    <xs:attribute name="velocity"     type="xs:string" default="0 0 0"/>
  </xs:complexType>

  <!-- BoxCollider: axis-aligned box with half-extents. -->
  <xs:complexType name="BoxColliderType">
    <xs:attribute name="center"        type="xs:string" default="0 0 0"/>
    <xs:attribute name="half_extents"  type="xs:string" default="0.5 0.5 0.5"/>
  </xs:complexType>

  <!-- SphereCollider: sphere. -->
  <xs:complexType name="SphereColliderType">
    <xs:attribute name="center" type="xs:string" default="0 0 0"/>
    <xs:attribute name="radius" type="xs:float"  default="0.5"/>
  </xs:complexType>

  <!-- CapsuleCollider: cylinder with rounded ends. -->
  <xs:complexType name="CapsuleColliderType">
    <xs:attribute name="center" type="xs:string" default="0 0 0"/>
    <xs:attribute name="radius" type="xs:float"  default="0.4"/>
    <xs:attribute name="height" type="xs:float"  default="1.8"/>
  </xs:complexType>

  <!-- Camera: render target. -->
  <xs:complexType name="CameraType">
    <xs:attribute name="fov"     type="xs:float" default="70.0"/>
    <xs:attribute name="near"    type="xs:float" default="0.1"/>
    <xs:attribute name="far"     type="xs:float" default="1000.0"/>
    <xs:attribute name="is_main" type="xs:boolean" default="false"/>
  </xs:complexType>

  <!-- Spawn region -->
  <xs:complexType name="SpawnRegionType">
    <xs:sequence>
      <xs:element name="entity" type="od:EntityType" minOccurs="1" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="name"     type="xs:string" use="required"/>
    <xs:attribute name="position" type="xs:string" default="0 0 0"/>
    <xs:attribute name="radius"   type="xs:float"  default="10.0"/>
  </xs:complexType>

</xs:schema>
